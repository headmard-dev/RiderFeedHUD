@echo off
setlocal
title Sauce for Zwift - Universal RiderFeedHUD Installer v13
echo ============================================================================
echo   Installing Universal RiderFeedHUD Mod v2.3 (v13) for Sauce for Zwift...
echo   - NEW in v12: Orange Attack Row (Reversed Dark Font), WKG-Only Column,
echo                 5m FTP (3.40 W/kg) Countdown Tank, 1m WTRL TTT Pull Pacer,
echo                 Zone 5/6/7 Redline 0-120s Timer, plus README.md ^& HELP.md
echo ============================================================================
echo.

set "SELF_PATH=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$raw = [IO.File]::ReadAllText($env:SELF_PATH); $ps = [regex]::Match($raw, '(?s)::PS_' + 'START::\r?\n(.+?)\r?\n::PS_' + 'END::').Groups[1].Value; Invoke-Expression $ps"

echo.
echo ============================================================================
echo   Installation Complete!
echo   Next Step: Click the HUD window in Sauce and press Ctrl+R (or restart Sauce).
echo ============================================================================
pause
exit /b 0

::PS_START::
$ErrorActionPreference = 'Stop'
$mPattern = '(?s)' + '::MANIFEST_' + 'B64_START::\s*(.+?)\s*::MANIFEST_' + 'B64_END::'
$hPattern = '(?s)' + '::HUD_' + 'B64_START::\s*(.+?)\s*::HUD_' + 'B64_END::'
$rPattern = '(?s)' + '::README_' + 'B64_START::\s*(.+?)\s*::README_' + 'B64_END::'
$helpPattern = '(?s)' + '::HELP_' + 'B64_START::\s*(.+?)\s*::HELP_' + 'B64_END::'

$manifestMatch = [regex]::Match($raw, $mPattern)
$hudMatch = [regex]::Match($raw, $hPattern)
$readmeMatch = [regex]::Match($raw, $rPattern)
$helpMatch = [regex]::Match($raw, $helpPattern)

if (-not $manifestMatch.Success -or -not $hudMatch.Success) {
    Write-Host '[ERROR] Could not read embedded HUD payload from batch file.' -ForegroundColor Red
    exit 1
}

$manifestBytes = [Convert]::FromBase64String(($manifestMatch.Groups[1].Value -replace '\s+', ''))
$hudBytes = [Convert]::FromBase64String(($hudMatch.Groups[1].Value -replace '\s+', ''))
$readmeBytes = if ($readmeMatch.Success) { [Convert]::FromBase64String(($readmeMatch.Groups[1].Value -replace '\s+', '')) } else { $null }
$helpBytes = if ($helpMatch.Success) { [Convert]::FromBase64String(($helpMatch.Groups[1].Value -replace '\s+', '')) } else { $null }

$targets = New-Object System.Collections.Generic.List[string]

$scriptDir = [System.IO.Path]::GetDirectoryName($env:SELF_PATH)
if ($scriptDir -match 'RiderFeedHUD$') {
    $targets.Add($scriptDir)
} elseif ($scriptDir -match 'SauceMods$') {
    $targets.Add((Join-Path $scriptDir 'RiderFeedHUD'))
}

$candidates = @(
    (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'SauceMods'),
    (Join-Path $env:USERPROFILE 'Documents\SauceMods'),
    (Join-Path $env:USERPROFILE 'OneDrive\Documents\SauceMods')
)

foreach ($c in $candidates) {
    if ($c -and (Test-Path -LiteralPath $c)) {
        $targets.Add((Join-Path $c 'RiderFeedHUD'))
    }
}

Get-PSDrive -PSProvider FileSystem | ForEach-Object {
    $root = $_.Root
    if ($root -and (Test-Path -LiteralPath $root)) {
        $usersDir = Join-Path $root 'Users'
        if (Test-Path -LiteralPath $usersDir) {
            Get-ChildItem -LiteralPath $usersDir -Directory -ErrorAction SilentlyContinue | ForEach-Object {
                $sm1 = Join-Path $_.FullName 'Documents\SauceMods'
                if (Test-Path -LiteralPath $sm1) { $targets.Add((Join-Path $sm1 'RiderFeedHUD')) }
                $sm2 = Join-Path $_.FullName 'OneDrive\Documents\SauceMods'
                if (Test-Path -LiteralPath $sm2) { $targets.Add((Join-Path $sm2 'RiderFeedHUD')) }
            }
        }
    }
}

if ($targets.Count -eq 0) {
    $docRoot = [Environment]::GetFolderPath('MyDocuments')
    if (-not $docRoot) { $docRoot = Join-Path $env:USERPROFILE 'Documents' }
    $fallback = Join-Path $docRoot 'SauceMods\RiderFeedHUD'
    $targets.Add($fallback)
}

$uniqueTargets = $targets | Select-Object -Unique

foreach ($t in $uniqueTargets) {
    $pagesDir = Join-Path $t 'pages'
    New-Item -ItemType Directory -Force -Path $pagesDir | Out-Null
    $manifestPath = Join-Path $t 'manifest.json'
    $hudPath = Join-Path $pagesDir 'hud.html'
    [IO.File]::WriteAllBytes($manifestPath, $manifestBytes)
    [IO.File]::WriteAllBytes($hudPath, $hudBytes)
    Write-Host ('[SUCCESS] Installed to: ' + $t) -ForegroundColor Green
    Write-Host ('   -> ' + $manifestPath + ' (' + $manifestBytes.Length + ' bytes)')
    Write-Host ('   -> ' + $hudPath + ' (' + $hudBytes.Length + ' bytes)')
    if ($readmeBytes) {
        $readmePath = Join-Path $t 'README.md'
        [IO.File]::WriteAllBytes($readmePath, $readmeBytes)
        Write-Host ('   -> ' + $readmePath + ' (' + $readmeBytes.Length + ' bytes)')
    }
    if ($helpBytes) {
        $helpPath = Join-Path $t 'HELP.md'
        [IO.File]::WriteAllBytes($helpPath, $helpBytes)
        Write-Host ('   -> ' + $helpPath + ' (' + $helpBytes.Length + ' bytes)')
    }
}
::PS_END::

